{
  "manifest_version": 3,
  "name": "myDNA Web Watcher",
  "version": "0.1.0",
  "description": "Bắt chính xác các tương tác với Web LLM (ChatGPT, Claude, Gemini) cho myDNA",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://claude.ai/*",
    "*://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "myDNA Web Watcher Active"
  }
}
